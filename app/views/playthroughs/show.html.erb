<h1><%= @playthrough.story.title %></h1>
<%# The window into the machine, and the only mark it leaves on the game.
    Absent entirely unless `Playthrough::Debug.enabled?` -- local by default --
    so a player who was handed a playthrough link is never shown one. %>
<p>
  <%= link_to "&larr; all stories".html_safe, root_path %>
  <% if Playthrough::Debug.enabled? %>
    &middot; <%= link_to "debug", playthrough_debug_path(@playthrough) %>
  <% end %>
</p>

<div class="preface"><%= @playthrough.story.preface %></div>
<hr>

<%# The log starts with the opening room, written as a Scene when the
    playthrough starts (PlaythroughsController#opening_scene). It used to be
    read out above the log only while the log was empty, which is why the first
    turn made it disappear.

    One wrapper, so the stylesheet can dim every logged turn but the last one.
    `streaming` says the newest turn is not in the log at all -- it is the
    #stream div below, which is what the player is actually reading -- so no
    logged turn should claim full-strength colour while it fills in. %>
<div class="<%= class_names("log", streaming: @command) %>">
  <%= render partial: "turns/turn", collection: @scenes, as: :turn %>
</div>

<% if @command %>
  <p class="command">&gt; <%= @command %></p>
  <div class="turn cursor" id="stream"></div>

  <%# Six lines of vanilla EventSource. No importmap, no Turbo -- a later
      stage swaps this for a Turbo Stream and the server side does not move. %>
  <script>
    var out = document.getElementById("stream");

    // Follow the narration down, but only while the player is already reading
    // the bottom. `stick` goes false the moment he scrolls away to re-read
    // something, and true again when he comes back -- our own scrollTo fires
    // this listener too, and lands at the bottom, so it re-arms itself.
    var stick = true;
    function atBottom() {
      var d = document.documentElement;
      return window.innerHeight + window.scrollY >= d.scrollHeight - 40;
    }
    function follow() { if (stick) window.scrollTo(0, document.documentElement.scrollHeight); }
    window.addEventListener("scroll", function () { stick = atBottom(); });

    var es = new EventSource("<%= playthrough_narration_path(@playthrough, command: @command) %>");
    es.addEventListener("token", function (e) { out.textContent += JSON.parse(e.data).t; follow(); });
    es.addEventListener("error", function (e) { es.close(); out.classList.remove("cursor"); });
    es.addEventListener("done", function () { es.close(); window.location = "<%= playthrough_path(@playthrough, anchor: "bottom") %>"; });
  </script>
<% else %>
  <%# Where the player is and what leads out of it. Not decoration: the exits
      are the move targets Playthrough::Classifier will accept, so a player
      who cannot read them is guessing at the one command that matters. %>
  <p class="place">
    <% if @playthrough.current_location %>
      You are in <strong><%= @playthrough.current_location.name %></strong>.
      Ways out: <%= @exits.any? ? @exits.map(&:name).to_sentence : "none that you can see." %>
    <% end %>
  </p>

  <%= form_with url: playthrough_turns_path(@playthrough) do |form| %>
    <%= form.text_field :command, autofocus: true, autocomplete: "off", placeholder: "what do you do?" %>
    <%= form.submit "Go" %>
  <% end %>
<% end %>

<%# Where the player left off. Every arrival at this page -- the redirect that
    carries a submitted command, the redirect after the turn finishes, a plain
    reload, Resume from the index -- links to `#bottom`, so the browser puts the
    newest turn on screen with no script involved. A brand new playthrough is
    the deliberate exception: PlaythroughsController#create sends the player to
    the top, where the preface and the opening arrival are. %>
<div id="bottom"></div>
