<%# Per-name agreement. Lab::Exits::Agreement owns attribution and eligibility.
    Both denominators remain visible even when no figure can be established. %>
<h3>
  <%= set.label %>
  <% if set.label == Lab::Exits::Agreement::HELD_OUT %>
    <span class="warn">[<%= Eval::HELD_OUT %> &mdash; apart, never pooled with the tuning worlds]</span>
  <% end %>
</h3>

<% if set.drawn.zero? %>
  <p class="absent">(nothing drawn in <%= set.label == Lab::Exits::Agreement::HELD_OUT ? "the held-out world" : "the tuning worlds" %> yet)</p>
<% else %>
  <p class="note">
    <%= pluralize(set.drawn, "sample") %>,
    <%= set.judged.size %> names judged,
    <%= set.unjudged %> names unjudged,
    <%= set.failed %> failed.
    <% if set.verdicts.any? %>
      &nbsp;&middot;&nbsp;
      <% Lab::Exits::Judgement::VERDICTS.each do |word| %>
        <%= debug_verdict(word) %> <%= set.verdicts[word].to_i %>&nbsp;
      <% end %>
    <% end %>
  </p>

  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>check</th><th>judgeable</th><th>eligible</th><th>agreement</th>
          <th>fired on good</th><th>weak</th><th>bad</th>
        </tr>
      </thead>
      <tbody>
        <% set.readings.each do |reading| %>
          <tr>
            <td>
              <%= reading.code.to_s.tr("_", " ") %>
              <% if reading.keyword? %><span class="absent">[keyword]</span><% end %>
            </td>
            <% if !reading.available? %>
              <td>0</td><td>0</td>
              <td colspan="4" class="absent">
                (unavailable &mdash; no attributable evidence for a name judgement)
              </td>
            <% elsif !reading.judged? %>
              <td><%= reading.judgeable %></td>
              <td>0</td>
              <td colspan="4" class="absent">
                (no verdict yet says anything about this check)
              </td>
            <% else %>
              <td><%= reading.judgeable %></td>
              <td><%= reading.eligible %></td>
              <td>
                <%= reading.fraction %>
                <% if reading.established? %>
                  &nbsp;<%= reading.percentage %>%
                <% else %>
                  <span class="absent">&mdash; not established</span>
                <% end %>
              </td>
              <td><%= reading.on_good.positive? ? tag.span(reading.on_good, class: "warn") : 0 %></td>
              <td><%= reading.on_weak %></td>
              <td><%= reading.on_bad %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# THE DISAGREEMENTS, OPENABLE. A count is a complaint; the sample page beside
      it carries the prompt as sent, which is the only thing that tells a wrong
      check from a right one. %>
  <h4>suspects &mdash; a check that fired on a name you called good</h4>
  <% if set.suspects.empty? %>
    <p class="absent">(none)</p>
  <% else %>
    <ul class="evidence">
      <% set.suspects.each do |suspect| %>
        <li>
          <%= link_to "sample ##{suspect.sample.id}", lab_exits_sample_path(suspect.sample) %>
          <%= suspect.code.to_s.tr("_", " ") %>
          &mdash; <%= suspect.name %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h4>missed &mdash; a name you called weak or bad that no attributable check fired on</h4>
  <% if set.missed.empty? %>
    <p class="absent">(none)</p>
  <% else %>
    <ul class="evidence">
      <% set.missed.each do |sample| %>
        <li>
          <%= link_to "sample ##{sample.sample.id}", lab_exits_sample_path(sample.sample) %>
          <%= debug_verdict(sample.verdict) %>
          <%= sample.aspect_names.any? ? sample.aspect_names.join(", ") : tag.span("(no aspect ticked)", class: "absent") %>
          &mdash; <%= sample.name %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h4>prose &mdash; kept, reported, never scored</h4>
  <p class="note">
    <%= set.prose_verdicts %> of <%= pluralize(set.judged.size, "judged name") %>
    faulted for teaser or name prose. No check reads prose and none is going to
    (<code>Eval::Realization::UNAVAILABLE_TO_A_REALIZATION</code>), so this is
    ground truth for a check that does not exist &mdash; not an agreement figure.
  </p>
<% end %>
