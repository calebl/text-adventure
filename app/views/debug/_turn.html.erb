<%# One turn, as the records tell it. `now` is the turn the player just took,
    which is the one the whole page is organised around. %>
<div class="panel <%= "now" if local_assigns[:now] %>">
  <div class="fields">
    <div class="k">branch</div>
    <div class="v">
      <%= debug_branch(turn.branch) %>
      <span class="note">scene #<%= turn.scene.id %></span>
    </div>

    <%# `scenes.typed`, with two fallbacks for turns written before that column
        existed -- `Interaction#user_input` on a talk turn, and the classifier's
        own prompt, which ends with the raw line. %>
    <div class="k">typed</div>
    <div class="v"><%= debug_value(turn.typed, absent: "not recorded — this turn predates Scene#typed and its classifier exchange is no longer kept") %></div>

    <%# WHAT THE TURN DID WITH IT, out of `scenes.resolved_action` and
        `scenes.acted_on` rather than worked out again from the branch. This is
        the one field on the page that says what CHANGED rather than what is,
        and it is the record `Story::Audit`'s transition checks read. %>
    <div class="k">resolved to</div>
    <div class="v">
      <%= debug_value(turn.scene.resolution,
                      absent: turn.opening? ? "nothing — an opening arrival is world data, not a turn anybody played" : "not recorded — this turn predates Scene#resolved_action (rake game:backfill_transitions)") %>
      <% if turn.scene.recorded_action.present? && turn.scene.acted_on_record.nil? %>
        <span class="note">the classifier resolved to no record — see Playthrough::Drift</span>
      <% end %>
    </div>

    <div class="k">story time</div>
    <div class="v">
      <%= debug_time(turn.scene.story_timestamp) %>
      &nbsp;&middot;&nbsp; <%= debug_minutes(turn.elapsed_minutes) %> since the turn before
    </div>

    <div class="k">place</div>
    <div class="v">
      <%= turn.scene.location.name %>
      <span class="tag <%= turn.scene.location.detail_level %>"><%= turn.scene.location.detail_level %></span>
    </div>

    <div class="k">cast recorded</div>
    <div class="v"><%= debug_value(turn.cast.map(&:fullname).to_sentence.presence, absent: "nobody — a narrated turn records no cast") %></div>

    <div class="k">summary</div>
    <div class="v"><%= debug_value(turn.scene.summary, absent: "none — Scene::Generator writes one, Scene::Narrator does not") %></div>

    <%# WHAT THE TURN COST, from the provider's own numbers rather than an
        estimate. Zero is not the same as unknown: an opening arrival was paid
        for at world-build time, and an old turn has had its receipts pruned. %>
    <div class="k">tokens</div>
    <div class="v">
      <% if turn.recorded? %>
        <%= turn.input_tokens %> in / <%= turn.output_tokens %> out
        <span class="note">across <%= pluralize(turn.conversations.size, "conversation") %></span>
      <% else %>
        <%= debug_value(nil, absent: turn.opening? ? "nothing — the opening arrival was generated when the world was built, not on this turn" : no_receipts_reason) %>
      <% end %>
    </div>

    <div class="k">model that answered</div>
    <div class="v">
      <%= debug_value(turn.models.to_sentence.presence, absent: "nothing recorded for this turn") %>
      <% if turn.models.size > 1 %>
        <span class="warn">more than one — BaseAgent rotated past a model that failed</span>
      <% end %>
    </div>

    <%# THE ONE FIELD ON THIS PAGE NOTHING GENERATED. Recorded a click at a time
        on the play page, and shown against the FROZEN provenance rather than
        against the row above it -- that is the whole point of freezing it. On a
        turn whose receipts are gone the two disagree, and the frozen one is the
        one that was true when the verdict was recorded. %>
    <div class="k">your verdict</div>
    <div class="v">
      <% if turn.judged? %>
        <%= debug_verdict(turn.feedback.verdict) %>
        <%= debug_value(turn.feedback.note, absent: "no note — the verdict was recorded on its own") %>
        <div class="note">
          frozen when recorded:
          prose written by <%= debug_value(turn.feedback.prose_model, absent: "unknown — the receipts for this turn were already pruned") %>
          <% if turn.feedback.prose_purpose %>as <code><%= turn.feedback.prose_purpose %></code><% end %>
          <% if turn.feedback.receipts_kept? %>
            &middot; <%= turn.feedback.input_tokens %> in / <%= turn.feedback.output_tokens %> out
            &middot; every model that answered the turn: <%= turn.feedback.answering_model_ids.to_sentence %>
          <% end %>
          <% if turn.feedback.rotated? %>
            <span class="warn">rotated — this prose took <%= turn.feedback.prose_model_ids.to_sentence %>, so it is not clean evidence about either alone</span>
          <% end %>
        </div>
      <% else %>
        <%= debug_value(nil, absent: "not judged — record one under the turn on the play page") %>
      <% end %>
    </div>
  </div>

  <h3>why the game says <%= turn.branch %></h3>
  <ul class="evidence">
    <% turn.evidence.each do |line| %>
      <li class="<%= "warn" if line.start_with?("ANOMALY") %>"><%= line %></li>
    <% end %>
  </ul>

  <h3>what the player read</h3>
  <%= debug_prose(turn.scene.description) %>

  <%# THE MACHINE'S SIDE OF THE SAME TURN. Every prompt sent and every answer
      that came back, in the order the loop asked them: classify first, then
      whichever branch the answer chose. %>
  <% if turn.recorded? %>
    <h3>what was actually sent, and what came back</h3>
    <%= render partial: "debug/conversation", collection: turn.conversations, as: :exchange %>
  <% end %>

  <% turn.interactions.each do |interaction| %>
    <%# THE SIX STRUCTURED FIELDS. The player only ever sees five of them
        rendered into prose by InteractionAgent's second pass, so this is the
        only place the character's own side of the exchange is legible -- and
        `inner_resolution` is never rendered at all. %>
    <h3>what <%= interaction.character_name %> actually thought (interaction #<%= interaction.id %>)</h3>
    <div class="fields">
      <div class="k">pre_thought</div><div class="v"><%= debug_value(interaction.pre_thought) %></div>
      <div class="k">pre_feeling</div><div class="v"><%= debug_value(interaction.pre_feeling) %></div>
      <div class="k">action</div><div class="v"><%= debug_value(interaction.action) %></div>
      <div class="k">post_feeling</div><div class="v"><%= debug_value(interaction.post_feeling) %></div>
      <div class="k">post_thought</div><div class="v"><%= debug_value(interaction.post_thought) %></div>
      <%# The sixth field, and the one the narrator pass is deliberately not
          told: what they decided is kept here rather than handed to the prose. %>
      <div class="k">inner_resolution</div>
      <div class="v"><%= debug_value(interaction.inner_resolution, absent: "not written — the model omitted the sixth schema field") %></div>
      <div class="k">summary</div>
      <div class="v"><%= debug_value(interaction.summary, absent: "not composed — Interaction derives one on create") %></div>
      <div class="k">completed?</div>
      <div class="v"><%= interaction.completed? %></div>
    </div>
  <% end %>
</div>
